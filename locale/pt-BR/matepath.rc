    AUTOCHECKBOX    "Habilitar seleção de linha completa.",IDC_FULLROWSELECT,10,70,120,10,WS_TABSTOP
    AUTOCHECKBOX    "Sempre ative a janela de destino quando um arquivo for aberto.",IDC_FOCUSEDIT,10,82,220,10,WS_TABSTOP
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,10,100,205,1
    AUTOCHECKBOX    "Mantenha a janela do Matepath sempre visível.",IDC_ALWAYSONTOP,10,109,150,10,WS_TABSTOP
    AUTOCHECKBOX    "Minimizar para a bandeja do sistema (clique para reativar).",IDC_MINIMIZETOTRAY,10,121,200,10,WS_TABSTOP
    AUTOCHECKBOX    "Tente reutilizar a janela existente quando o matepath for iniciado.",IDC_REUSEWINDOW,10,133,220,10,WS_TABSTOP
    CONTROL         "<a>Clear window position history</a>",IDC_CLEARWINPOS,"SysLink",WS_TABSTOP,20,145,103,12
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,10,161,205,1
    AUTOCHECKBOX    "Salvar configurações ao sair.",IDC_SAVESETTINGS,10,170,100,10,WS_TABSTOP
    CONTROL         "<a>About matepath</a>",IDC_ABOUT,"SysLink",WS_TABSTOP,130,170,80,12
END

