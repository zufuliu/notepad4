IDR_MAINWND MENU
BEGIN
	POPUP "+"
	BEGIN
		MENUITEM "&Abrir (Same Window)",			IDM_FILE_OPENSAME
		MENUITEM "Abrir (N&ew Window)",			IDM_FILE_OPENNEW
		MENUITEM "&Executar...",						IDM_FILE_RUN
		MENUITEM "&Lançar",						IDM_FILE_LAUNCH
		MENUITEM "&Visão geral",					IDM_FILE_QUICKVIEW
		MENUITEM "Abra &com...",				IDM_FILE_OPENWITH
		MENUITEM "&Copiar nome do arquivo",				IDM_POP_COPY_FILENAME
		MENUITEM "Copiar nome do pa&th",				IDM_POP_COPY_PATHNAME
		MENUITEM SEPARATOR
		MENUITEM "Mostrar no explorer",			IDM_FILE_EXPLORER
		MENUITEM "Criar Lin&k...",				IDM_FILE_CREATELINK
		MENUITEM "&Salvar Como...",					IDM_FILE_SAVEAS
		MENUITEM "Copiar/&Mover...",				IDM_FILE_COPYMOVE
		MENUITEM "&Deletar...",					IDM_FILE_DELETE
		MENUITEM "Re&nomear...",					IDM_FILE_RENAME
		MENUITEM SEPARATOR
		MENUITEM "&Propiedades",					IDM_FILE_PROPERTIES
	END
	POPUP "+"
	BEGIN
		MENUITEM "&Novo arquivo...",				IDM_FILE_NEW
		MENUITEM "No&vo Diretório...",			IDM_FILE_NEWDIR
		MENUITEM SEPARATOR
		MENUITEM "Filtro de Arquivos...",				IDM_VIEW_FILTER
		MENUITEM "&Limpar Filtro",				IDM_VIEW_FILTERALL
		POPUP "&Mostrar"
		BEGIN
			MENUITEM "&Diretórios",			IDM_VIEW_FOLDERS
			MENUITEM "&arquivos",					IDM_VIEW_FILES
			MENUITEM "&Objetos do sistema",			IDM_VIEW_HIDDEN
		END
		POPUP "Organizar"
		BEGIN
			MENUITEM "by &Nome",				IDM_SORT_NAME
			MENUITEM "by &tamanho",				IDM_SORT_SIZE
			MENUITEM "by &Tipo",				IDM_SORT_TYPE
			MENUITEM "by &Data",				IDM_SORT_DATE
			MENUITEM SEPARATOR
			MENUITEM "&Reverso",				IDM_SORT_REVERSE
		END
		MENUITEM SEPARATOR
		MENUITEM "Abrir no &Explorer",			IDM_FILE_EXPLORER
		MENUITEM "Vá para &Favoritos",				IDM_VIEW_FAVORITES
		MENUITEM "&Abrir Favoritos",				IDM_VIEW_EDITFAVORITES
		MENUITEM "&Diretório...",				IDM_FILE_CHANGEDIR
		MENUITEM "&Vá para...",					IDM_FILE_GOTO
		MENUITEM SEPARATOR
		MENUITEM "Mostrar Drivers",				IDM_VIEW_DRIVEBOX
		MENUITEM "&Mantenha-se atualizado",				IDM_VIEW_ALWAYSONTOP
		MENUITEM SEPARATOR
		MENUITEM "Salvar Configurações",				IDM_VIEW_SAVESETTINGS
		MENUITEM "Setup alvo...",			IDM_VIEW_FINDTARGET
		MENUITEM "Opções...",					IDM_VIEW_OPTIONS
	END
	POPUP "+"
	BEGIN
		MENUITEM "&Diretório...",				IDM_FILE_CHANGEDIR
		MENUITEM "Drive & Propriedades",			IDM_FILE_DRIVEPROP
		MENUITEM SEPARATOR
		MENUITEM "Mostrar Dri&ves",				IDM_VIEW_DRIVEBOX
	END
	POPUP "+"
	BEGIN
		MENUITEM "Mostrar &Toolbar",				IDM_VIEW_TOOLBAR
		MENUITEM "&Customizar Toolbar...",		IDM_VIEW_CUSTOMIZETB
		MENUITEM "&Escala Automática da Toolbar",			IDM_VIEW_AUTO_SCALE_TOOLBAR
#if NP2_ENABLE_HIDPI_IMAGE_RESOURCE
		MENUITEM "Usar Too&lbar Grande",			IDM_VIEW_USE_LARGE_TOOLBAR
#endif
		MENUITEM "Mostrar &Barra de Status",				IDM_VIEW_STATUSBAR
	END
	POPUP "+"
	BEGIN
		MENUITEM "&Abrir matepath",				IDM_TRAY_RESTORE
		MENUITEM SEPARATOR
		MENUITEM "&Sair do matepath",				IDM_TRAY_EXIT
	END
END


