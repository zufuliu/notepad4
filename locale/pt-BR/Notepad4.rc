    AUTOCHECKBOX    "Texto Puro",IDC_SCAN_WORD_INSIDE_PLAINTEXT,380,123,65,10,WS_TABSTOP
    GROUPBOX        "Caracteres para alternar comentário de linha em código Assembler",IDC_STATIC,231,143,218,26
