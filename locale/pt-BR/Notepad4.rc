STRINGTABLE
BEGIN
	IDS_BACKSLASHHELP		"Transformações de Barra Invertida\n\n\
\\a\tAlerta (BEL, ASCII 7)\n\
\\b\tBackspace (BS, ASCII 8)\n\
\\e\tEscape (ESC, ASCII 27 / 1B)\n\
\\f\tAlimentação de formulário (FF, ASCII 12 / 0C)\n\
\\n\tNova linha (LF, ASCII 10 / 0A)\n\
\\r\tRetorno de transporte (CR, ASCII 13 / 0D)\n\
\\t\tTabulação Horizontal (HT, ASCII 9)\n\
\\v\tTabulação Vertical (VT, ASCII 11 / 0B)\n\
\\uHHHH\tValor Hexadecimal\n\
\\xHH\tValor Hexadecimal\n\
\\\\\tBarra Invertida"

	IDS_REGEXPHELP			"Sintaxe Comum de Expressões Regulares\n\n\
.\tQualquer caractere\n\
^\tInício de uma linha\n\
$\tFim de uma linha\n\
\\<\tInício de uma palavra\n\
\\>\tFim de uma palavra\n\
[...]\tUm conjunto de caracteres ([abc]) ou um intervalo ([a-z])\n\
[^...]\tCaracteres FORA do conjunto ou intervalo\n\
\\d\tQualquer dígito decimal\n\
\\D\tQualquer caractere não numérico\n\
\\s\tQualquer caractere de espaço em branco\n\
\\S\tQualquer caractere que não seja espaço em branco\n\
\\w\tQualquer caractere de ""palavra""\n\
\\W\tQualquer caractere que não seja de ""palavra""\n\
\\x\tEscapa caractere com significado especial\n\
\\xHH\tCaractere com código hexadecimal HH\n\
?\tCorresponde ao anterior 0 ou 1 vez\n*\tCorresponde ao anterior 0 ou mais vezes\n\
+\tCorresponde ao anterior 1 ou mais vezes\n\
*? ou +?\tCorrespondência não gulosa dos quantificadores ""?"" e ""+""\n\
(\tInício de um grupo\n\
)\tFim de um grupo\n\
\\n ou $n\tRefere-se ao grupo na substituição (n de 1 a 9)\n\n\
Sintaxe Boost Perl Regex:\n\
a|b\tCorresponde a a ou b\n\
{n}\tCorresponde ao anterior exatamente n vezes\n\
{n,m}\tCorresponde ao anterior entre n e m vezes"

	IDS_WILDCARDHELP		"Pesquisa com Caracteres Curinga\n\n\
*\tCorresponde a zero ou mais caracteres.\n\
?\tCorresponde a exatamente um caractere. "
END

