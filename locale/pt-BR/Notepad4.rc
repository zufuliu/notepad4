IDD_AUTOCOMPLETION DIALOGEX 0, 0, 456, 195
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configurações de Conclusão Automática"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "",IDC_STATIC,7,7,218,98
    AUTOCHECKBOX    "Completar palavras ao digitar.",IDC_AUTO_COMPLETE_WORD,14,6,122,10,WS_TABSTOP
    LTEXT           "Quantidade de itens visíveis na lista:",IDC_STATIC,14,18,148,10,SS_RIGHT
    EDITTEXT        IDC_AUTOC_VISIBLE_ITEM_COUNT,166,16,50,12,ES_NUMBER | WS_TABSTOP
    LTEXT           "Tamanho mínimo para palavra:",IDC_STATIC,14,34,148,10,SS_RIGHT
    EDITTEXT        IDC_AUTOC_MIN_WORD_LENGTH,166,32,50,12,ES_NUMBER | WS_TABSTOP
    LTEXT           "Tamanho mínimo para número (sem prefixo):",IDC_STATIC,14,50,148,10,SS_RIGHT
    EDITTEXT        IDC_AUTOC_MIN_NUMBER_LENGTH,166,48,50,12,ES_NUMBER | WS_TABSTOP
    AUTOCHECKBOX    "Escanear palavras no documento atual por",IDC_AUTOC_SCAN_DOCUMENT_WORDS,14,68,150,10,WS_TABSTOP
    EDITTEXT        IDC_AUTOC_SCAN_WORDS_TIMEOUT,166,64,50,12,WS_TABSTOP
    AUTOCHECKBOX    "Usar apenas palavras do documento atual.",IDC_AUTOC_ONLY_DOCUMENT_WORDS,14,80,180,10,WS_TABSTOP
    AUTOCHECKBOX    "Ativar conclusão automática apenas no modo IME em inglês.",IDC_AUTOC_ENGLISH_IME_ONLY,14,92,180,10,WS_TABSTOP

    GROUPBOX        "Completar palavras dentro de:",IDC_STATIC,7,111,218,26
    AUTOCHECKBOX    "Comentário",IDC_AUTO_COMPLETE_INSIDE_COMMONT,14,123,65,10,WS_TABSTOP
    AUTOCHECKBOX    "String",IDC_AUTO_COMPLETE_INSIDE_STRING,85,123,65,10,WS_TABSTOP
    AUTOCHECKBOX    "Texto Puro",IDC_AUTO_COMPLETE_INSIDE_PLAINTEXT,156,123,65,10,WS_TABSTOP
    GROUPBOX        "Teclas para finalizar conclusão automática (use Esc para cancelar)",IDC_STATIC,7,143,218,44
    AUTOCHECKBOX    "Enter",IDC_AUTOC_FILLUP_ENTER,14,155,65,10,WS_TABSTOP
    AUTOCHECKBOX    "Tab",IDC_AUTOC_FILLUP_TAB,85,155,65,10,WS_TABSTOP
    AUTOCHECKBOX    "Espaço",IDC_AUTOC_FILLUP_SPACE,156,155,65,10,WS_TABSTOP
    AUTOCHECKBOX    "Pontuação:",IDC_AUTOC_FILLUP_PUNCTUATION,14,173,50,10,WS_TABSTOP
    EDITTEXT        IDC_AUTOC_FILLUP_PUNCTUATION_LIST,66,170,150,12,WS_TABSTOP

    AUTOCHECKBOX    "Recuar texto automaticamente.",IDC_AUTO_INDENT_TEXT,231,7,200,10,WS_TABSTOP
    AUTOCHECKBOX    "Fechar tags HTML e XML automaticamente.",IDC_AUTO_CLOSE_TAGS,231,19,200,10,WS_TABSTOP
    AUTOCHECKBOX    "Inserir espaço após vírgula (,) quando apropriado.",IDC_AUTO_INSERT_SPACE_COMMA,231,31,218,10,WS_TABSTOP
    AUTOCHECKBOX    "Inserir espaço após o marcador ao alternar comentário de linha.",IDC_AUTO_INSERT_SPACE_COMMENT,231,43,218,10,WS_TABSTOP
    GROUPBOX        "Completar chaves, colchetes, parênteses e aspas",IDC_STATIC,231,56,218,49
    AUTOCHECKBOX    "( )",IDC_AUTO_INSERT_PARENTHESIS,238,68,40,10,WS_TABSTOP
    AUTOCHECKBOX    "{ }",IDC_AUTO_INSERT_BRACE,290,68,40,10,WS_TABSTOP
    AUTOCHECKBOX    "[ ]",IDC_AUTO_INSERT_SQUARE_BRACKET,342,68,40,10,WS_TABSTOP
    AUTOCHECKBOX    "< >",IDC_AUTO_INSERT_ANGLE_BRACKET,394,68,40,10,WS_TABSTOP
    AUTOCHECKBOX    "Aspas duplas ("""").",IDC_AUTO_INSERT_DOUBLE_QUOTE,238,80,100,10,WS_TABSTOP
    AUTOCHECKBOX    "Aspas simples ('').",IDC_AUTO_INSERT_SINGLE_QUOTE,342,80,100,10,WS_TABSTOP
    AUTOCHECKBOX    "Crase (``).",IDC_AUTO_INSERT_BACKTICK,238,92,100,10,WS_TABSTOP

    GROUPBOX        "Escanear palavras para conclusão dentro de:",IDC_STATIC,231,111,218,26
