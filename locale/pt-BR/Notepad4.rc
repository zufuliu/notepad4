IDD_ABOUT DIALOGEX 0, 0, 255, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Notepad4"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,142,123,50,14
    PUSHBUTTON      "Copiar",IDC_COPY_BUILD_INFO,198,123,50,14
    ICON            IDR_MAINWND,IDC_STATIC,14,7,20,20
    LTEXT           "",IDC_VERSION,45,7,200,8
    LTEXT           "",IDC_BUILD_INFO,45,18,200,16
    LTEXT           "Copyright © 2011-2026 Zufu Liu e todos os colaboradores.",IDC_STATIC,45,38,200,8
    CONTROL         "",IDC_NEW_PAGE_LINK,"SysLink",WS_TABSTOP,45,48,200,10
    LTEXT           "Copyright © 2010-2017 XhmikosR e todos os colaboradores.",IDC_STATIC,45,60,200,8
    CONTROL         "",IDC_MOD_PAGE_LINK,"SysLink",WS_TABSTOP,45,68,200,10
    LTEXT           "Copyright © 2004-2012 Florian Balmer.",IDC_STATIC,45,80,200,8
    CONTROL         "",IDC_WEBPAGE_LINK,"SysLink",WS_TABSTOP,45,88,200,10
    LTEXT           "Contato com Florian Balmer:",IDC_STATIC,45,100,94,8
    CONTROL         "",IDC_EMAIL_LINK,"SysLink",WS_TABSTOP,45,108,94,10
    LTEXT           "Visite o site do Scintilla:",IDC_STATIC,45,120,94,8
    CONTROL         "",IDC_SCI_PAGE_LINK,"SysLink",WS_TABSTOP,45,128,94,10
END

IDD_FIND DIALOGEX 0, 0, 290, 124
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Localizar Texto"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
