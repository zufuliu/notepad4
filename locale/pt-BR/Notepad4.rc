			MENUITEM "Remover Escape de Caracteres HTML/&XML\tAlt+Shift+H",	IDM_EDIT_XHTML_UNESCAPE_CHAR
			MENUITEM SEPARATOR
			MENUITEM "Codificar &URL\tCtrl+Shift+E",				IDM_EDIT_URLENCODE
			MENUITEM "Codificar Componente de URL",					IDM_EDIT_URLCOMPONENTENCODE
			MENUITEM "Decodificar UR&L\tCtrl+Shift+R",				IDM_EDIT_URLDECODE
		END
	END
	POPUP "A&juda"
	BEGIN
		MENUITEM "Página do &Projeto",				IDM_HELP_PROJECT_HOME
		MENUITEM "Último &Lançamento",				IDM_HELP_LATEST_RELEASE
		MENUITEM "Última &Compilação",				IDM_HELP_LATEST_BUILD
		MENUITEM "Relatar &Problema",				IDM_HELP_REPORT_ISSUE
		MENUITEM "Sugerir &Recurso",			IDM_HELP_FEATURE_REQUEST
		MENUITEM SEPARATOR
		MENUITEM "&Wiki Online",				IDM_HELP_ONLINE_WIKI
		MENUITEM "Ajuda da Linha de &Comando",			IDM_CMDLINE_HELP
		MENUITEM SEPARATOR
		MENUITEM "S&obre o Notepad4\tF1",			IDM_HELP_ABOUT
	END
END

IDR_POPUPMENU MENU
BEGIN
	POPUP "+"
	BEGIN
		MENUITEM "&Desfazer",						IDM_EDIT_UNDO
		MENUITEM "&Refazer",						IDM_EDIT_REDO
		MENUITEM SEPARATOR
		MENUITEM "Cor&tar",						IDM_EDIT_CUT
		MENUITEM "&Copiar",						IDM_EDIT_COPY
		MENUITEM "Co&lar",						IDM_EDIT_PASTE
		MENUITEM "&Excluir",						IDM_EDIT_DELETE
		MENUITEM SEPARATOR
		MENUITEM "Selecionar &Tudo",					IDM_EDIT_SELECTALL
		MENUITEM SEPARATOR
		MENUITEM "Alternar &Dobra",				IDM_VIEW_FOLD_CURRENT_BLOCK
		MENUITEM SEPARATOR
		MENUITEM "&Abrir",						CMD_OPEN_PATH_OR_LINK
	END
	POPUP "+"
	BEGIN
		MENUITEM "Exibir &Menu",					IDM_VIEW_MENU
		MENUITEM "Exibir Barra de &Ferramentas",				IDM_VIEW_TOOLBAR
		MENUITEM "&Personalizar Barra de Ferramentas...",		IDM_VIEW_CUSTOMIZE_TOOLBAR
		MENUITEM "Dimensionar Barra de Ferramentas &Auto.",			IDM_VIEW_AUTO_SCALE_TOOLBAR
#if NP2_ENABLE_HIDPI_IMAGE_RESOURCE
		MENUITEM "Usar Barra de Ferramentas &Grande",			IDM_VIEW_USE_LARGE_TOOLBAR
#endif
		MENUITEM "Exibir Barra de E&status",				IDM_VIEW_STATUSBAR
	END
	POPUP "+"
	BEGIN
		MENUITEM "&Abrir Notepad4",				IDM_TRAY_RESTORE
		MENUITEM SEPARATOR
		MENUITEM "Sai&r do Notepad4",				IDM_TRAY_EXIT
	END
	POPUP "+"
	BEGIN
		MENUITEM "Níveis Pa&drão",				IDM_VIEW_FOLD_DEFAULT
		MENUITEM "&Todos os Níveis",					IDM_VIEW_FOLD_ALL
		MENUITEM "Bloco &Atual",				IDM_VIEW_FOLD_CURRENT_BLOCK
		MENUITEM "Níve&l Atual",				IDM_VIEW_FOLD_CURRENT_LEVEL
		MENUITEM SEPARATOR
		MENUITEM "Nível &1",					IDM_VIEW_FOLD_LEVEL1
		MENUITEM "Nível &2",					IDM_VIEW_FOLD_LEVEL2
		MENUITEM "Nível &3",					IDM_VIEW_FOLD_LEVEL3
		MENUITEM "Nível &4",					IDM_VIEW_FOLD_LEVEL4
		MENUITEM "Nível &5",					IDM_VIEW_FOLD_LEVEL5
		MENUITEM "Nível &6",					IDM_VIEW_FOLD_LEVEL6
		MENUITEM "Nível &7",					IDM_VIEW_FOLD_LEVEL7
		MENUITEM "Nível &8",					IDM_VIEW_FOLD_LEVEL8
		MENUITEM "Nível &9",					IDM_VIEW_FOLD_LEVEL9
		MENUITEM "Nível 1&0",					IDM_VIEW_FOLD_LEVEL10
	END
END


